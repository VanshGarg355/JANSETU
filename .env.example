# ==============================================================
# JanSetu Configuration
# Note: If keys are left blank, JanSetu automatically operates in
# Demo Mode with pre-populated verified schemes and simulated AI!
# ==============================================================

# Backend Server Port
PORT=4000
BASE_URL=http://localhost:4000

# Supabase PostgreSQL & Auth Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# AI Assistant Key (Groq or OpenAI)
# If using Groq (Fast & Free Tier):
GROQ_API_KEY=your_groq_api_key_here

# Or OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# Optional: real-time answers via web search (free key at tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Frontend (set on Vercel, NOT secret): your Render backend URL, no trailing slash
# VITE_API_URL=https://jansetu-backend-muok.onrender.com
